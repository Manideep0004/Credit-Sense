  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SLO & Reliability Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "API Availability SLO (99.5% Target)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(creditsense_api_requests_total{status_code=~\"5..\"}[1h])) or vector(0)) / (sum(rate(creditsense_api_requests_total[1h])) or vector(1)))",
          "legendFormat": "Availability %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 95,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.0 },
              { "color": "green", "value": 99.5 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Applications Processed (Total & Decisions)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(creditsense_applications_total)",
          "legendFormat": "Total Applications",
          "refId": "A"
        },
        {
          "expr": "sum(creditsense_applications_total{decision=\"APPROVED\"})",
          "legendFormat": "Approved",
          "refId": "B"
        },
        {
          "expr": "sum(creditsense_applications_total{decision=\"REJECTED\"})",
          "legendFormat": "Rejected",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis Celery Queue Depth",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "creditsense_queue_depth",
          "legendFormat": "Pending Applications",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "p99 Pipeline Latency (SLO: < 5s)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(creditsense_application_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3.5 },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Pipeline Performance & Agent Breakdown",
      "type": "row"
    },
    {
      "id": 5,
      "title": "End-to-End Pipeline Latency Percentiles (p50, p90, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(creditsense_application_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Median)",
